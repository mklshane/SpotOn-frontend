EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (client-safe values only - never the secret key)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon key also works.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development-only model for the two recognized demo photos; all other photos use the standard model.
EXPO_PUBLIC_DEMO_BCC_MODEL=0
