+global_ref<JByteBuffer> ResizePlugin::cachedBuffer(BufferCache& cache, size_t size, std::string debugName) {
+  for (auto& entry : cache) {
+    if (entry.first == size) return entry.second;
+  }
+  // A handful of sizes per stage in practice (skin + detector, a few search crops). Bound it anyway
+  // so a continuous pinch-zoom cannot grow it without limit.
+  if (cache.size() >= 6) cache.erase(cache.begin());
+  cache.emplace_back(size, allocateBuffer(size, debugName));
+  return cache.back().second;
+}
